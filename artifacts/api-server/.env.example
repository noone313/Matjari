# يرث هذا الملف متغيرات .env الموجودة في جذر المشروع.
# عند التشغيل المحلي يُقرأ .env من الجذر تلقائياً عبر dotenv.
# لا تحتاج لتغيير شيء هنا إذا أعددت الجذر بشكل صحيح.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/matjari
SESSION_SECRET=change-me-to-a-long-random-string
PORT=8080
NODE_ENV=development
