# Frontend — Vite dev server
PORT=5173
BASE_PATH=/

# عنوان API Server المحلي (يُستخدم لإعداد الـ proxy تلقائياً)
API_PORT=8080

# عنوان API الأساسي الذي تُوجَّه إليه كل طلبات /api/... بشكل مطلق (بدل الـ proxy).
# يُقرأ عند البناء (build time) من Vite — في الإنتاج على Railway اجعله رابط خادم الـ API
# المنشور: https://<your-api-service>.up.railway.app (بدون /api — المسارات المولدة تبدأ به).
# محلياً يُشير للخادم المحلي مباشرة فيُتجاوز الـ proxy.
VITE_API_URL=http://localhost:8080
